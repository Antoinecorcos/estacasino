{
  // Configuration Cloudflare d'Estacasino.
  // Les secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) ne sont JAMAIS ici :
  // ils se saisissent dans le tableau de bord Cloudflare ou avec `wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estacasino",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // URL publique du site, sans « / » final (retours de paiement Stripe).
    // En local, elle est remplacée par celle du fichier .dev.vars (APP_URL=http://localhost:8787).
    "APP_URL": "https://estacasino.com"
  },
  // Tâche planifiée : rappels sur téléphone (bonus du jour à 10 h, filet de sécurité). Heures en UTC ;
  // le Worker regarde lui-même l'heure de Paris, d'où un passage toutes les 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estacasino",
      // Remplacer par l'identifiant donné par `wrangler d1 create estacasino`.
      "database_id": "5d3f5fa4-acd5-49e0-a468-a79c7fd7d4d9",
      "migrations_dir": "migrations"
    }
  ],
  // Limites de débit (par adresse IP) : connexion / inscription, et reste de l'API.
  "ratelimits": [
    { "name": "LIMITE_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LIMITE_API", "namespace_id": "1002", "simple": { "limit": 150, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS_BLACKJACK", "class_name": "BlackjackRoom" },
      { "name": "ROOMS_ROULETTE", "class_name": "RouletteRoom" },
      { "name": "ROOMS_POKER", "class_name": "PokerRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BlackjackRoom", "RouletteRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PokerRoom"] }
  ],
  "observability": { "enabled": true }
}
